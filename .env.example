# Copier ce fichier en .env et l'adapter. Toutes les valeurs ont un défaut (environnement de test).

# --- Base PostgreSQL (docker-compose fourni) ---
PG_HOTE=localhost
PG_PORT=5433
PG_BASE=dentagest
# Rôle restreint utilisé pour traiter les mails (créé par « python -m assistant_mails installer »)
PG_UTILISATEUR=assistant_mails
PG_MOT_DE_PASSE=assistant_mails_test
# Compte propriétaire : sert UNIQUEMENT aux commandes « installer » et « reinitialiser »
PG_ADMIN_UTILISATEUR=cabinet
PG_ADMIN_MOT_DE_PASSE=cabinet

# --- LLM local (serveur Ollama sur un autre PC du réseau) ---
OLLAMA_URL=http://192.168.1.124:11434
# qwen3:8b : validé en réel sur le serveur de test (6,6 Go, tient dans une carte de 8 Go).
# Matériel définitif du cabinet (carte de 16 à 24 Go) : mistral-small3.2, modèle européen de 24 B.
OLLAMA_MODELE=qwen3:8b
OLLAMA_TIMEOUT=120
# OLLAMA_THINK=false    # réglé automatiquement : désactivé pour qwen3, deepseek-r1... ; non envoyé sinon
LLM_ACTIF=true

# --- Dossiers (défaut : ./documents et ./sorties à la racine du projet) ---
# DOSSIER_DOCUMENTS=/chemin/vers/documents/dentagest
# DOSSIER_SORTIES=/chemin/vers/sorties

# --- Date « du jour » imposée (jeu de test : 2026-10-07) ; vide = date réelle ---
# DATE_REFERENCE=2026-10-07
